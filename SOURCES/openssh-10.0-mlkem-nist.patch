+int
+kex_kem_mlkem768nistp256_dec(struct kex *kex, const struct sshbuf *server_blob,
+    struct sshbuf **shared_secretp)
+{
+	return kex_kem_mlkem_nist_dec(kex, server_blob, shared_secretp,
+		crypto_kem_mlkem768_CIPHERTEXTBYTES);
+}
