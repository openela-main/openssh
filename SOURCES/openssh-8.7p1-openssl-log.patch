 void	 sshlog(const char *, const char *, int, int,
     LogLevel, const char *, const char *, ...)
     __attribute__((format(printf, 7, 8)));
+void	 sshlog_openssl(int);
 void	 sshlogv(const char *, const char *, int, int,
