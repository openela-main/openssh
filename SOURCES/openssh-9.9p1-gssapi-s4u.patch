+			    options.num_gss_proxy_services == 0)
+				filter = SSH_GSSAPI_CCFILTER_TGT |
+				    SSH_GSSAPI_CCFILTER_PROXY;
+			else if (!options.gss_allow_s4u2self)
+				filter = SSH_GSSAPI_CCFILTER_SELF;
+			if (filter != 0)
